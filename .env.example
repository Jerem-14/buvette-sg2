# Copiez ce fichier vers .env.local. Sans Redis, le mode local ne fonctionne qu'en développement.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_KEY_PREFIX=buvette
APP_URL=http://localhost:3000
# Utilisés uniquement par npm run db:seed, jamais pour une connexion directe.
ADMIN_EMAIL=admin@example.fr
ADMIN_NAME=Responsable
ADMIN_PASSWORD=
